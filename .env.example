# Set these in Cloudflare Pages → Settings → Environment variables (Production).
# Do NOT commit real values. These are read by the functions at runtime.

SUPABASE_URL=https://lfizcpaqolckemrvsooy.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key
ADMIN_PASSWORD=choose-a-dashboard-password
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
# Optional — defaults to the request origin if unset:
SITE_URL=https://your-site.pages.dev

# Tool Finals (/tests/) — all required for the test system:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
INSTRUCTOR_PIN=choose-an-instructor-answer-key-pin
GUEST_PIN=choose-a-guest-access-pin
# Shared secret issued by /api/verify-test-access and required by POST /api/tests:
TESTS_WRITE_TOKEN=choose-a-long-random-token
